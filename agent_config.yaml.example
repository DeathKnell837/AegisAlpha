# agent_config.yaml
# Add your Band Agent credentials here.
# Get these from app.band.ai -> Agents -> New Agent (External Agent).

# Repeat this block for each of the 3 required agents.
planner_agent:
  agent_id: "your-planner-agent-uuid"
  api_key: "your-planner-agent-api-key"
  handle: "@your-username/planner-agent"

executor_agent:
  agent_id: "your-executor-agent-uuid"
  api_key: "your-executor-agent-api-key"
  handle: "@your-username/executor-agent"

reviewer_agent:
  agent_id: "your-reviewer-agent-uuid"
  api_key: "your-reviewer-agent-api-key"
  handle: "@your-username/reviewer-agent"
